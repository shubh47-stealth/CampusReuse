rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isChatMember(chatId) {
      return signedIn() &&
        request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
    }

    // ---------- User profiles: private ----------
    // Contains email, hostel block and room number, so only the owner can read it.
    match /users/{uid} {
      allow read: if isSelf(uid);
      allow create: if isSelf(uid) && request.resource.data.uid == uid;
      allow update: if isSelf(uid) && request.resource.data.uid == uid;
      allow delete: if false;
    }

    // ---------- Public profiles: name and hostel only ----------
    // This is the contact privacy guard: email and room number never live here.
    match /publicProfiles/{uid} {
      allow read: if signedIn();
      allow create, update: if isSelf(uid)
                            && request.resource.data.keys().hasOnly(['uid', 'fullName', 'hostelBlock'])
                            && request.resource.data.uid == uid;
      allow delete: if false;
    }

    // ---------- Marketplace items: public read when active ----------
    // Queries must filter on status == 'active' to be allowed.
    match /items/{itemId} {
      allow read: if resource.data.status == 'active'
                  || (signedIn() && resource.data.ownerId == request.auth.uid);
      allow create: if signedIn()
                    && request.resource.data.ownerId == request.auth.uid
                    && request.resource.data.status == 'active'
                    && request.resource.data.title is string
                    && request.resource.data.title.size() > 0
                    && request.resource.data.price is number
                    && request.resource.data.price >= 0;
      // Only the owner can change an item, the owner can't be swapped,
      // status must stay one of the three states, and "sold" is final.
      allow update: if signedIn()
                    && resource.data.ownerId == request.auth.uid
                    && resource.data.status != 'sold'
                    && request.resource.data.ownerId == resource.data.ownerId
                    && request.resource.data.status in ['active', 'reserved', 'sold'];
      allow delete: if signedIn() && resource.data.ownerId == request.auth.uid;
    }

    // ---------- Lost & Found reports: signed-in students only ----------
    // Queries must filter on status == 'open' to be allowed.
    match /lostFound/{reportId} {
      allow read: if signedIn()
                  && (resource.data.status == 'open'
                      || resource.data.reporterId == request.auth.uid);
      allow create: if signedIn()
                    && request.resource.data.reporterId == request.auth.uid
                    && request.resource.data.type in ['lost', 'found']
                    && request.resource.data.status == 'open'
                    && request.resource.data.title is string
                    && request.resource.data.title.size() > 0
                    && request.resource.data.title.size() <= 80;
      // The reporter can close their own open report; "returned" is final.
      allow update: if signedIn()
                    && resource.data.reporterId == request.auth.uid
                    && resource.data.status == 'open'
                    && request.resource.data.reporterId == resource.data.reporterId
                    && request.resource.data.status in ['open', 'returned'];
      allow delete: if signedIn() && resource.data.reporterId == request.auth.uid;
    }

    // ---------- Direct chats: private to the two participants ----------
    match /chats/{chatId} {
      allow read: if signedIn() && request.auth.uid in resource.data.participants;
      allow create: if signedIn()
                    && request.auth.uid in request.resource.data.participants
                    && request.resource.data.participants.size() == 2;
      allow update: if signedIn() && request.auth.uid in resource.data.participants;
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if isChatMember(chatId);
        allow create: if isChatMember(chatId)
                      && request.resource.data.senderId == request.auth.uid;
        allow update, delete: if false;
      }
    }

    // Everything else is denied by default.
  }
}
